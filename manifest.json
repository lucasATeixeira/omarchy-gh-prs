{
  "schemaVersion": 1,
  "id": "lucas.gh-prs",
  "name": "GitHub PRs",
  "version": "1.0.0",
  "author": "Lucas",
  "license": "MIT",
  "description": "Your open GitHub pull requests with their CI status. Needs the gh CLI, logged in with gh auth login.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "GitHub PRs",
    "description": "Worst CI status of your open PRs; click for the full list",
    "category": "Apps",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 10,
      "aiCheckNames": "CodeRabbit",
      "notificationsEnabled": true,
      "notifyAiReviewDone": true,
      "notifyCiPassed": true,
      "notifyCiFailed": true,
      "notifyApproved": true,
      "notifyChangesRequested": true
    },
    "schema": [
      { "key": "refreshIntervalSec", "type": "integer", "label": "Refresh interval (seconds)", "min": 5, "max": 3600, "step": 5 },
      { "key": "aiCheckNames", "type": "string", "label": "AI check patterns (comma-separated)" },
      { "key": "notificationsEnabled", "type": "boolean", "label": "All notifications" },
      { "key": "notifyAiReviewDone", "type": "boolean", "label": "Notify when the AI review is done" },
      { "key": "notifyCiPassed", "type": "boolean", "label": "Notify when CI passed" },
      { "key": "notifyCiFailed", "type": "boolean", "label": "Notify when CI failed" },
      { "key": "notifyApproved", "type": "boolean", "label": "Notify when a PR is approved" },
      { "key": "notifyChangesRequested", "type": "boolean", "label": "Notify when changes are requested" }
    ]
  }
}
